      data:
        guid: examiner_exam_details
        position: {x: 360, y: 0}
        title: ExamDetails
        text: "First, Control. Approach the focus orb and channel your symbol into it. Let's see if you can keep your mana steady.\n\nSecond, Pressure. When you're ready, step onto the marked seal. You'll face a test of reflex and focus, destroy the targets before they vanish.\n\nAnd finally, Combat. Move to the central arena and declare your readiness. The constructs of the Academy will test your skill in real confrontation.\n\nEach test will push you further. Few make it through all three, fewer still with their confidence intact."
        choices:
        - id: examiner_details_1
          text: I'm ready.
          nextNodeGuid: examiner_start_exam_event
          lockMode: 0
          conditions: []
        - id: examiner_details_2
          text: I'm not ready.
          nextNodeGuid: 
          lockMode: 0
          conditions: []
